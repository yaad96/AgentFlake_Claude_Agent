# Use an Ubuntu-based image with Java 8 and Maven installed
FROM maven:3.8.6-openjdk-8

# Set the working directory inside the container
WORKDIR /app

# Make your scripts executable
#RUN chmod +x /app/run_nondex.sh /app/run_test_flaky_nondex_mod.sh /app/run_test_fixed_nondex_mod.sh

# Install necessary build tools and dependencies for Python, and other required packages
# The base image is Debian 11 (bullseye). Its packages are no longer served by
# deb.debian.org, so apt-get install 404s (exit 100). The image already ships
# commented-out snapshot.debian.org sources pinned to 20220801T000000Z; switch to
# them. That both fixes the 404s and pins the exact package versions the original
# image was built with, so containers built now match ones built earlier.
RUN set -eux; \
    sed -i -e 's|^deb http://deb.debian.org|# deb http://deb.debian.org|' \
           -e 's|^deb http://security.debian.org|# deb http://security.debian.org|' \
           -e 's|^# deb http://snapshot.debian.org|deb http://snapshot.debian.org|' \
           /etc/apt/sources.list; \
    printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "5";\n' \
      > /etc/apt/apt.conf.d/99snapshot

RUN apt-get update && \
    apt-get install -y autoconf automake libtool curl make g++ unzip python3 python3-pip && \
    ln -s /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

# Install xmllint (libxml2-utils)
RUN apt update && apt install -y libxml2-utils

# Install xmlstarlet in a separate layer
RUN apt-get update && \
    apt-get install -y xmlstarlet && \
    rm -rf /var/lib/apt/lists/*

# Install NonDex Maven plugin
RUN mvn edu.illinois:nondex-maven-plugin:2.1.1:help -q

# Claude Code CLI — used by the agentic_claude_cli driver (the "Claude Code
# agent" repair variant). Installed to /root/.local/bin. Auth is supplied at
# run time via the ANTHROPIC_API_KEY env var passed to `docker exec`.
RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/root/.local/bin:${PATH}"
RUN claude --version

# Automatically run the flaky test script with the required arguments
CMD ["./run_flaky_nondex_mod.sh", "nifi-nar-bundles/nifi-solr-bundle/nifi-solr-processors", "org.apache.nifi.processors.solr.TestQuerySolr#testAttributes", "5"]

